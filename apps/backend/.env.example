# -----------------------------------------------------------------------------
# Crypto wallet mode
# CRYPTO_WALLET_MODE: "mock" skips Coinbase and blockchain calls; "real" enables them.
# MOCK_WALLET_INITIAL_BALANCE_USDC: starting balance for newly created mock wallets.
# -----------------------------------------------------------------------------
CRYPTO_WALLET_MODE=mock
MOCK_WALLET_INITIAL_BALANCE_USDC=500

# Coinbase credentials are required only when CRYPTO_WALLET_MODE=real.
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
CDP_WALLET_SECRET=your_cdp_wallet_secret
CDP_APP_ID=your_cdp_app_id

# -----------------------------------------------------------------------------
# Base network / blockchain configuration
# BASE_SEPOLIA_RPC_URL: RPC endpoint URL for Base Sepolia.
# USDC_CONTRACT_ADDRESS: USDC token contract address on your target network.
# TREASURY_WALLET_ADDRESS: backend treasury wallet public address.
# TREASURY_PRIVATE_KEY: private key for signing treasury transactions.
# -----------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_api_key
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TREASURY_WALLET_ADDRESS=0xYourTreasuryWalletAddress
TREASURY_PRIVATE_KEY=0xYourTreasuryPrivateKey

# -----------------------------------------------------------------------------
# Safaricom Daraja sandbox
# DARAJA_BASE_URL: Safaricom host used for OAuth, B2C, and B2B API requests.
# DARAJA_CONSUMER_KEY / DARAJA_CONSUMER_SECRET: credentials from your Daraja app.
# DARAJA_SHORTCODE: sandbox business shortcode used as PartyA and initiator.
# DARAJA_PASSKEY: Daraja initiator password.
# DARAJA_SANDBOX_SECURITY_CREDENTIAL: optional pre-generated sandbox test credential.
# DARAJA_PUBLIC_CERTIFICATE: required for live APIs; PEM certificate with newlines escaped as \n.
# DARAJA_SANDBOX_B2C_MSISDN: Safaricom's allowed sandbox B2C recipient.
# The original phone entered in the app is still stored in transaction history.
# WEBHOOK_BASE_URL: public HTTPS URL exposing this backend, such as an ngrok URL.
# Callbacks are received at ${WEBHOOK_BASE_URL}/api/mpesa/callback.
# NGROK_AUTHTOKEN: secret token from https://dashboard.ngrok.com/get-started/your-authtoken.
# -----------------------------------------------------------------------------
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_daraja_initiator_password
# DARAJA_SANDBOX_SECURITY_CREDENTIAL=your_pre_generated_sandbox_credential
# DARAJA_PUBLIC_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DARAJA_SANDBOX_B2C_MSISDN=254708374149
WEBHOOK_BASE_URL=https://your-public-tunnel.example
NGROK_AUTHTOKEN=your_ngrok_authtoken

# -----------------------------------------------------------------------------
# Application security and persistence
# JWT_SECRET: secret used to sign/verify JWT tokens.
# DATABASE_URL: database connection string.
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_strong_secret
DATABASE_URL=postgresql://user:password@localhost:5432/saftap

# -----------------------------------------------------------------------------
# Server configuration
# -----------------------------------------------------------------------------
PORT=4000
